import torch
import torch.nn as nn

from models.virchow2 import Virchow2Encoder

from modules.topk_selector import TopKSelector
from modules.fusion import CrossAttentionFusion
from modules.ordinal_head import OrdinalRegressionHead


class HER2Former(nn.Module):


    def __init__(
        self,
        freeze_backbone=False,
        top_k=64,
        embed_dim=1280,
        num_heads=8,
        num_classes=4,
        dropout=0.1,
        use_topk=True,
    ):

        super().__init__()

        self.use_topk = use_topk
        self.top_k = top_k

        # ------------------------------------------------
        # Backbone
        # ------------------------------------------------

        self.encoder = Virchow2Encoder(
            freeze_backbone=freeze_backbone
        )

        # ------------------------------------------------
        # Top-K Token Routing
        # ------------------------------------------------

        if self.use_topk:

            self.token_selector = TopKSelector(
                embed_dim=embed_dim,
                top_k=top_k
            )

        else:

            self.token_selector = None

        # ------------------------------------------------
        # Cross Attention Fusion
        # ------------------------------------------------

        self.fusion = CrossAttentionFusion(
            embed_dim=embed_dim,
            num_heads=num_heads,
            dropout=dropout
        )

        # ------------------------------------------------
        # Ordinal Regression
        # ------------------------------------------------

        self.ordinal_head = OrdinalRegressionHead(
            embed_dim=embed_dim,
            num_classes=num_classes,
            dropout=dropout
        )

    def forward(
        self,
        x,
        return_attention=False
    ):

        """
        Args:
            x:
                [B,3,224,224]

            return_attention:
                If True, return attention and token information.

        Returns:
            logits:
                [B,3]

            If return_attention=True:
                dictionary containing:
                    logits
                    attention_weights
                    token_scores
                    token_indices
        """

        # ==================================================
        # Virchow2
        # ==================================================

        cls_token, register_tokens, patch_tokens = self.encoder(x)

        # patch_tokens:
        # [B,256,1280]

        # ==================================================
        # Token Routing
        # ==================================================

        if self.use_topk:

            selected_tokens, token_scores, token_indices = (
                self.token_selector(patch_tokens)
            )

        else:

            # Ablation:
            # use all 256 patch tokens

            selected_tokens = patch_tokens

            token_scores = None
            token_indices = None

        # ==================================================
        # Cross Attention Fusion
        # ==================================================

        fused_feature, attention_weights = self.fusion(
            cls_token,
            selected_tokens
        )

        # ==================================================
        # Ordinal Prediction
        # ==================================================

        logits = self.ordinal_head(
            fused_feature
        )

        # ==================================================
        # Optional Attention Output
        # ==================================================

        if return_attention:

            return {
                "logits": logits,
                "attention_weights": attention_weights,
                "token_scores": token_scores,
                "token_indices": token_indices
            }

        return logits
